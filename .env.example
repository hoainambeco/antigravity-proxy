# Proxy Server Configuration
PORT=8045
HOST=0.0.0.0

# API Key Authentication
# PROXY_API_KEY: (Optional) Master API key. If not set, system uses dynamic keys from SQLite.
# PROXY_API_KEY=sk-my-master-secret-key

# Database Configuration (TypeORM + SQLite)
# SQLITE_DB_PATH: Path to SQLite database file for API keys (default: ./data/antigravity.sqlite)
# SQLITE_DB_PATH=./data/antigravity.sqlite

# Path to accounts store file (default: ./accounts.json)
ACCOUNTS_FILE=./accounts.json

# Routing & Behavior
# Optional custom system prompt or thought handling
ROUTING_STRATEGY=round-robin

# --- OAuth client credentials (REQUIRED) ---
# This repository ships no credentials. Supply your own; both must be set or every
# OAuth operation fails. See the "OAuth Client Credentials" section of the README.
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Optional: additional clients, 'key|client_id|client_secret[|label]' separated by ';'
# Reusing the key 'antigravity_enterprise' overrides the pair above.
# ANTIGRAVITY_OAUTH_CLIENTS=my_client|...apps.googleusercontent.com|...|My Client

# Optional: which client key to start with (default: antigravity_enterprise)
# ANTIGRAVITY_OAUTH_CLIENT_KEY=antigravity_enterprise
