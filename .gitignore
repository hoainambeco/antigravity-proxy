# Dependencies
node_modules/

# Build output
dist/
build/
packages/*/dist/
packages/*/tsconfig.tsbuildinfo
*.bun-build
docs-site/.astro/
docs-site/.astro-dist/
docs-site/src/content/docs/

# Local CLI dev state + materialized contract cache (regenerated by sota build/deploy)
.sota/

# Environment files
.env
.env.local
.env.*.local
.env.prod

# Docker local overrides
docker-compose.override.yml

# Keep example env
!.env.example

# Prisma (root-only, so it doesn't shadow runtime asset dirs named "generated/" deeper in the tree)
/generated/
/prisma/generated/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/
test-results/
playwright-report/
bench-results/

# Temp files
/tmp/
/temp/

repomix-output.xml
.serena/cache
!plans/templates/*
screenshots/*
docs/screenshots/*
logs.txt
test-ck
__pycache__

# CK meta commands
prompt.md
ck.md

.claude/
.claude.bak/
.claude.backup/

# Agent memory (project scope)
.claude/agent-memory/

# Hook diagnostics logs
.claude/hooks/.logs/

# Gemini CLI settings (symlink to .claude/.mcp.json)
.gemini/settings.json
.claude/settings.bak.json
# External repos for study/reference
external/

# Git worktrees (local development only)
worktrees/
# MongoDB keyfile (generated, not committed)
.docker/mongodb-keyfile

# Requirements
requirements/

# Kiro (local-only; skills symlinked to .agent/skills)
.kiro/

.claude/scripts/*
.agent/rules
.agent/skills

# Codex settings
.codex/
.agents/
.claudeignore
.repomixignore

.understand-anything/

# Local env backups (e.g. .env.bak.<timestamp>) — may contain real secrets
.env.bak*
# Per-region env files and any suffixed backup of one. The patterns above miss
# both: `.env.*.local` needs the .local tail, and `.env.bak*` does not match
# `.env.region-japan.bak-cors`. These hold real MONGODB_URI credentials, so a
# single `git add .` would publish two regions' databases.
.env.region-*
.env*.bak-*

# seat-limit backfill script output (contains org ids/names)
seat-limit-backfill-report.json
accounts.json
